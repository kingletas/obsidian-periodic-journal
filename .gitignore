node_modules/
main.js
*.js.map
tests/build/

# Settings written by Obsidian in the installed plugin folder. They are not
# source: they hold one vault's note types, and they belong to that vault.
data.json

# The user-level ~/.gitignore is core.excludesFile for every repository under
# $HOME and excludes *.sh outright. Without this negation the release workflow
# fails on a script that was never pushed.
!*.sh

# Disposable output: build products, screenshots, working images, scratch
# notes. Nothing here is reviewed and nothing here is committed.
#
# It carries its own line because the machine this was written on hides it
# through a user-level excludes file, and a clone has none of that.
local.d/
